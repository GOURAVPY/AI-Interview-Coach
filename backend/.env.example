# Copy this file to ".env" in the backend folder and fill in the values.
# The real .env is git-ignored. Never commit it.

# --- Server ---
PORT=4000
# Where the frontend runs. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Nginx, Cloudflare),
# so the per-network demo limit sees each visitor's real address.
TRUST_PROXY=

# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-interview-coach

# --- Login sessions: a long random string ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Gemini (get a key at https://aistudio.google.com) ---
GEMINI_API_KEY=
# Optional model overrides
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SCORING_MODEL=gemini-3.6-flash

# --- Cost control: live voice is billed by the minute ---
# Voice minutes one signed-in user can use per day (UTC).
USER_DAILY_VOICE_MINUTES=30
# Voice minutes across ALL users per month. Set this to what your bill can bear.
GLOBAL_MONTHLY_VOICE_MINUTES=600
# Demo visitors without an account: seconds each, and a daily total per network.
DEMO_SECONDS_PER_VISITOR=180
DEMO_NETWORK_DAILY_SECONDS=600
